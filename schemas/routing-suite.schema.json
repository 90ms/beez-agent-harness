{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beez.dev/schemas/routing-suite-v1.json",
  "title": "Beez Natural-language Routing Suite",
  "type": "object",
  "required": ["schemaVersion", "id", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "locale",
          "prompt",
          "expected",
          "requiredSkills",
          "forbiddenActions"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "locale": { "enum": ["ko", "en", "mixed"] },
          "prompt": { "type": "string", "minLength": 4 },
          "expected": { "$ref": "workflow-route.schema.json" },
          "requiredSkills": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "forbiddenActions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
