{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beez.dev/schemas/agent-harness-project-v1.json",
  "title": "Beez Agent Harness Project Configuration",
  "type": "object",
  "required": ["schemaVersion", "commands", "boundaries"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "profiles": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        }
      },
      "additionalProperties": false
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
